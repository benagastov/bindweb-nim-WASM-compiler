# =============================================================================
# versions.env — single source of truth for every upstream pin.
#
# Sourced by build.sh, toolchain/*.sh, and read by CI. Change a pin here,
# rebuild, and every artifact is reproducible from these exact references.
# =============================================================================

# ---- Prebuilt clang toolchain (the in-browser C/C++ compiler) ---------------
# The clang.js npm package republishes the official prebuilt binaries of
# binji's LLVM fork (clang/lld compiled to wasm32-wasi + wasi sysroot) — the
# only clang.wasm known to work in the browser. We fetch these prebuilt
# artifacts (pinned + SHA-256 verified by toolchain/fetch-clang.sh); we never
# build LLVM from source. The JS driver (clang.js) is not fetched: the
# proven, fully patched copy ships in toolchain/vendor-src/clang.js
# (see toolchain/vendor-src/PROVENANCE.md).
CLANGJS_NPM_VERSION="0.1.1"
# Mirror 1: npm registry tarball (single download, hash-verified).
CLANGJS_TARBALL_URL="https://registry.npmjs.org/clang.js/-/clang.js-${CLANGJS_NPM_VERSION}.tgz"
# Mirror 2: per-file CDN mirror of the same package.
CLANGJS_CDN_URL="https://cdn.jsdelivr.net/npm/clang.js@${CLANGJS_NPM_VERSION}/dist"
# Artifacts fetched into web/vendor/clang/ (clang.js comes from vendor-src):
#   clang.wasm lld.wasm memfs.wasm sysroot.tar
WASM_CLANG_FILES="clang.wasm lld.wasm memfs.wasm sysroot.tar"

# ---- LLVM / Clang / LLD (informational; from-source path only) ---------------
# binji's LLVM fork carries the patches that let clang/lld compile to wasm32-wasi
# and talk to the in-memory filesystem (memfs). The prebuilt artifacts above are
# built from this fork; the pin records exactly which source produced them.
#   https://github.com/binji/llvm-project   (branch: master)
LLVM_REPO="https://github.com/binji/llvm-project"
LLVM_REF="5dc09c94393510bc8d042a9f07382b53e845c0f2"
# clang's resource-dir version string baked into this LLVM (used by the
# sysroot.tar layout and by the clang launch flags in SPEC section 5).
# binji's fork is LLVM 8.0.1-era.
LLVM_RESOURCE_VER="8.0.1"

# ---- wasi-sdk (optional; from-source path only) ------------------------------
# Only needed if you rebuild LLVM/memfs from source (toolchain/clang-sources/).
# wasi-sdk-12 is the last series whose wasi-libc still exposes <wasi/core.h>,
# which binji's memfs.c includes. If you port memfs.c to the modern
# <wasi/api.h>, use WASI_SDK_REF_MODERN instead.
WASI_SDK_REPO="https://github.com/WebAssembly/wasi-sdk"
WASI_SDK_REF_LEGACY="db1b572d4b55e8d8cbc5cc7f950246efa6f55ed2"   # wasi-sdk-12
WASI_SDK_REF_MODERN="a6f46397e473699e9f29c878fd563f532e7c0e3c"   # wasi-sdk-24
WASI_SDK_REF="${WASI_SDK_REF_LEGACY}"
WASI_SDK_VERSION_LEGACY="12.0"
WASI_SDK_VERSION_MODERN="24.0"

# ---- Nim (the compiler we cross-compile to wasm) -----------------------------
#   https://github.com/nim-lang/Nim
NIM_REPO="https://github.com/nim-lang/Nim"
NIM_REF="cdaaef08b0ad189e21cdd09a4c861306ec22d4e4"             # v2.0.14
NIM_VERSION="2.0.14"
# Nim 2.0 moved some stdlib into split repos; pin the ones the compiler needs.
NIM_CHECKSUMS_REPO="https://github.com/nim-lang/checksums"
NIM_CHECKSUMS_REF="HEAD"
NIM_CSOURCES_REPO="https://github.com/nim-lang/csources_v2"
NIM_CSOURCES_REF="HEAD"

# ---- Emscripten (emits nim.wasm + nim-bundle.js) -----------------------------
#   https://github.com/emscripten-core/emsdk
# The in-browser nim-bundle.js is an Emscripten module; we build it from
# source with a pinned emsdk so the JS glue stays byte-compatible in shape.
EMSDK_REPO="https://github.com/emscripten-core/emsdk"
EMSDK_REF="a36df02dc438e8b02f91122a4c62eeecb6784272"           # 3.1.69
EMSDK_VERSION="3.1.69"

# ---- Output layout -----------------------------------------------------------
# Where finished artifacts land. web/ is assembled into dist/ by
# tools/make-dist.sh; web/vendor/ is populated by the build and not committed.
VENDOR_CLANG_DIR="web/vendor/clang"   # clang.wasm lld.wasm memfs.wasm sysroot.tar clang.js
VENDOR_NIM_DIR="web/vendor/nim"       # nim.wasm nim-bundle.js nimbase.h
DIST_DIR="dist"
