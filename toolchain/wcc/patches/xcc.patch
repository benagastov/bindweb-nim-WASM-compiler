diff --git a/src/wcc/wasm_linker.c b/src/wcc/wasm_linker.c
index 965ed64..7f24fd2 100644
--- a/src/wcc/wasm_linker.c
+++ b/src/wcc/wasm_linker.c
@@ -1214,8 +1214,30 @@ static inline void verbose_link_result(WasmLinker *linker) {
   }
 }
 
+// Functions the input objects ask to export: export_name (WASM_SYM_EXPORTED)
+// always; with --export-dynamic also every global, non-hidden function.
+// Archive members (libc) are not scanned, like wasm-ld's --export-dynamic.
+static void collect_object_exports(WasmLinker *linker, Table *exports) {
+  for (int i = 0; i < linker->files->len; ++i) {
+    File *file = linker->files->data[i];
+    if (file->kind != FK_WASMOBJ)
+      continue;
+    Vector *symtab = file->wasmobj->linking.symtab;
+    for (int j = 0; j < symtab->len; ++j) {
+      SymbolInfo *sym = symtab->data[j];
+      if (sym->kind != SIK_SYMTAB_FUNCTION || (sym->flags & WASM_SYM_UNDEFINED) ||
+          (sym->flags & WASM_SYM_BINDING_LOCAL) || sym->name == NULL)
+        continue;
+      if ((sym->flags & WASM_SYM_EXPORTED) ||
+          (linker->options.export_dynamic && !(sym->flags & WASM_SYM_VISIBILITY_HIDDEN)))
+        table_put(exports, sym->name, (void*)sym->name);
+    }
+  }
+}
+
 bool link_wasm_objs(WasmLinker *linker, Table *exports, uint32_t stack_size) {
   const Name *name;
+  collect_object_exports(linker, exports);
   for (int it = 0; (it = table_iterate(exports, it, &name, NULL)) != -1; ) {
     table_put(&linker->unresolved, name, NULL);
   }
