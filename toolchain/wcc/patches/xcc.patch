+static OUTFILE _stderr = {.file={.iof = &kIofOut, .flush = FFLUSH, .fd = STDERR_FILENO, .flag = FF_WRITE, .wbuf = _stderr.wwork, .wcapa = sizeof(_stderr.wwork), .unget_char=EOF}};
